#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
    zephyr,user {
        /* idx: 0=ladder tracks(AIN0), 1=ladder vol(AIN1), 2..5=faders1..4(AIN3,6,2,7), 6=battery(AIN4) */
        io-channels = <&adc 0>, <&adc 1>, <&adc 2>, <&adc 3>, <&adc 4>, <&adc 5>, <&adc 6>;
        /* M3.2 TRS MIDI out: ring = PNP current-source base on P0.23, active-LOW
         * (drive logical-1 to enable; the GPIO_ACTIVE_LOW flag inverts it to the
         * electrical low the PNP base wants). Coexists with io-channels above. */
        midi_ring_gpios = <&gpio0 23 GPIO_ACTIVE_LOW>;
    };
    chosen { zephyr,console = &cdc_acm_uart0; };

    /* The USB-MIDI surface is now the hand-rolled USB-MIDI 1.0 class
     * (usb_midi1.c), which needs no DT node — it is registered via
     * USBD_DEFINE_CLASS. The old zephyr,midi2-device node was removed along with
     * the usbd_midi2 function. */
};

/* M3.2 TRS MIDI out (31250 baud, TX-only) on uart1/uarte1.
 * Tip data = UARTE TXD on P0.20 (idles high = MIDI mark/"1"). P0.20 is the
 * most-likely TXD per the CA-033/RP-054 research; if the on-hardware bench
 * (scope + OP-XY) later shows P0.17 is the real tip TXD, flip the psels pin
 * number below from 20 to 17 — a one-line pinctrl change.
 * A second tip pin (P0.17, a parallel current copy) is only needed if one pin
 * cannot drive the MIDI opto; DEFERRED until one-pin drive proves too weak. */
&pinctrl {
    uart1_default: uart1_default { group1 { psels = <NRF_PSEL(UART_TX, 0, 20)>; }; };
    uart1_sleep:   uart1_sleep   { group1 { psels = <NRF_PSEL(UART_TX, 0, 20)>; low-power-enable; }; };

    /* LED PWM (mirrors the gold sp1-midi BSP stem_player-pinctrl.dtsi).
     * PWM2 = track row, PWM3 = side/play row. Channel->pin per the CANONICAL LED map. */
    pwm2_default: pwm2_default { group1 {
        psels = <NRF_PSEL(PWM_OUT0, 0, 29)>,   /* T1 P0.29 */
                <NRF_PSEL(PWM_OUT1, 0, 26)>,   /* T2 P0.26 */
                <NRF_PSEL(PWM_OUT2, 1, 15)>,   /* T3 P1.15 */
                <NRF_PSEL(PWM_OUT3, 1, 14)>;   /* T4 P1.14 */
    }; };
    pwm2_sleep: pwm2_sleep { group1 {
        psels = <NRF_PSEL(PWM_OUT0, 0, 29)>, <NRF_PSEL(PWM_OUT1, 0, 26)>,
                <NRF_PSEL(PWM_OUT2, 1, 15)>, <NRF_PSEL(PWM_OUT3, 1, 14)>;
        low-power-enable;
    }; };
    pwm3_default: pwm3_default { group1 {
        psels = <NRF_PSEL(PWM_OUT0, 0, 1)>,    /* PLAY1 P0.01 */
                <NRF_PSEL(PWM_OUT1, 1, 12)>,   /* PLAY2 P1.12 */
                <NRF_PSEL(PWM_OUT2, 0, 0)>,    /* PLAY3 P0.00 */
                <NRF_PSEL(PWM_OUT3, 1, 13)>;   /* PLAY4 P1.13 (== SP1_LED1) */
    }; };
    pwm3_sleep: pwm3_sleep { group1 {
        psels = <NRF_PSEL(PWM_OUT0, 0, 1)>, <NRF_PSEL(PWM_OUT1, 1, 12)>,
                <NRF_PSEL(PWM_OUT2, 0, 0)>, <NRF_PSEL(PWM_OUT3, 1, 13)>;
        low-power-enable;
    }; };
};

/* Enable the two PWM peripherals that drive the 8 LEDs (raw GPIO drive is replaced
 * by led.c). ~1 kHz, active-high normal polarity, so duty% == LED brightness. */
&pwm2 {
    status = "okay";
    pinctrl-0 = <&pwm2_default>; pinctrl-1 = <&pwm2_sleep>; pinctrl-names = "default","sleep";
};
&pwm3 {
    status = "okay";
    pinctrl-0 = <&pwm3_default>; pinctrl-1 = <&pwm3_sleep>; pinctrl-names = "default","sleep";
};

/ {
    /* pwm-leds container (gold-BSP pattern). led.c references these child labels in
     * FIXED order: idx 0..3 = track T1..T4, idx 4..7 = side/play LED1..4 (feldd
     * numbering; see the CANONICAL LED map in sp1_board.h). compatible="pwm-leds"
     * gives each child's `pwms` a binding (needed for PWM_DT_SPEC_GET); we drive
     * the channels directly, so CONFIG_LED_PWM is intentionally NOT enabled. */
    feldd_leds: feldd-leds {
        compatible = "pwm-leds";
        fled_t1: fled_t1 { pwms = <&pwm2 0 PWM_USEC(1024) PWM_POLARITY_NORMAL>; };  /* T1 P0.29 */
        fled_t2: fled_t2 { pwms = <&pwm2 1 PWM_USEC(1024) PWM_POLARITY_NORMAL>; };  /* T2 P0.26 */
        fled_t3: fled_t3 { pwms = <&pwm2 2 PWM_USEC(1024) PWM_POLARITY_NORMAL>; };  /* T3 P1.15 */
        fled_t4: fled_t4 { pwms = <&pwm2 3 PWM_USEC(1024) PWM_POLARITY_NORMAL>; };  /* T4 P1.14 */
        fled_p1: fled_p1 { pwms = <&pwm3 0 PWM_USEC(1024) PWM_POLARITY_NORMAL>; };  /* PLAY1 P0.01 */
        fled_p2: fled_p2 { pwms = <&pwm3 1 PWM_USEC(1024) PWM_POLARITY_NORMAL>; };  /* PLAY2 P1.12 */
        fled_p3: fled_p3 { pwms = <&pwm3 2 PWM_USEC(1024) PWM_POLARITY_NORMAL>; };  /* PLAY3 P0.00 */
        fled_p4: fled_p4 { pwms = <&pwm3 3 PWM_USEC(1024) PWM_POLARITY_NORMAL>; };  /* PLAY4 P1.13 */
    };
};
&uart1 {
    compatible = "nordic,nrf-uarte"; status = "okay";
    current-speed = <31250>;
    pinctrl-0 = <&uart1_default>; pinctrl-1 = <&uart1_sleep>; pinctrl-names = "default","sleep";
    /* TX-only MIDI out: no RX/RTS/CTS. P0.20 = tip TXD (most-likely; flip to
     * P0.17 if the bench shows otherwise). Second tip pin P0.17 (parallel
     * current copy) deferred until one-pin drive proves too weak. */
};

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;
    channel@0 { reg=<0>; zephyr,gain="ADC_GAIN_1_6"; zephyr,reference="ADC_REF_INTERNAL";
        zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,20)>;
        zephyr,input-positive=<NRF_SAADC_AIN0>; zephyr,resolution=<12>; };   /* ladder: tracks */
    channel@1 { reg=<1>; zephyr,gain="ADC_GAIN_1_6"; zephyr,reference="ADC_REF_INTERNAL";
        zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,20)>;
        zephyr,input-positive=<NRF_SAADC_AIN1>; zephyr,resolution=<12>; };   /* ladder: vol */
    channel@2 { reg=<2>; zephyr,gain="ADC_GAIN_1_6"; zephyr,reference="ADC_REF_INTERNAL";
        zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,20)>;
        zephyr,input-positive=<NRF_SAADC_AIN3>; zephyr,resolution=<12>; };   /* fader1 P0.05 */
    channel@3 { reg=<3>; zephyr,gain="ADC_GAIN_1_6"; zephyr,reference="ADC_REF_INTERNAL";
        zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,20)>;
        zephyr,input-positive=<NRF_SAADC_AIN6>; zephyr,resolution=<12>; };   /* fader2 P0.30 */
    channel@4 { reg=<4>; zephyr,gain="ADC_GAIN_1_6"; zephyr,reference="ADC_REF_INTERNAL";
        zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,20)>;
        zephyr,input-positive=<NRF_SAADC_AIN2>; zephyr,resolution=<12>; };   /* fader3 P0.04 */
    channel@5 { reg=<5>; zephyr,gain="ADC_GAIN_1_6"; zephyr,reference="ADC_REF_INTERNAL";
        zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,20)>;
        zephyr,input-positive=<NRF_SAADC_AIN7>; zephyr,resolution=<12>; };   /* fader4 P0.31 */
    channel@6 { reg=<6>; zephyr,gain="ADC_GAIN_1_6"; zephyr,reference="ADC_REF_INTERNAL";
        zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,20)>;
        zephyr,input-positive=<NRF_SAADC_AIN4>; zephyr,resolution=<12>; };   /* battery P0.28 */
};

/* The nRF52840 USB device-controller nodelabel is &usbd; there is no
 * zephyr_udc0 alias on this SoC. The sample_usbd helper (sample_usbd_init.c)
 * hard-references DT_NODELABEL(zephyr_udc0), so we attach that extra label here
 * and hang the CDC-ACM console child node off it. */
zephyr_udc0: &usbd {
    status = "okay";
    cdc_acm_uart0: cdc_acm_uart0 { compatible = "zephyr,cdc-acm-uart"; };

    /* Studio phase 2a: a first-party Zephyr usbd_hid boot-keyboard function
     * (usb_hid.c), joining the same sample_usbd composite as the CDC console +
     * USB-MIDI 1.0. Mirrors samples/subsys/usb/hid-keyboard's hid_dev_0 node: a
     * standard 8-byte boot-keyboard input report (modifiers, reserved, 6 keycodes),
     * polled at 1 ms. The driver (usbd_hid.c, compat zephyr,hid-device) builds the
     * HID interface + a single interrupt-IN endpoint and self-registers into the
     * composite via usbd_register_all_classes (it is NOT on the helper's blocklist,
     * which only excludes dfu_dfu). Presence of this node auto-selects
     * CONFIG_USBD_HID_SUPPORT (default y when DT_HAS_ZEPHYR_HID_DEVICE_ENABLED). */
    hid_dev_0: hid_dev_0 {
        compatible = "zephyr,hid-device";
        label = "FELDD-HID";
        protocol-code = "keyboard";
        in-report-size = <8>;
        in-polling-period-us = <1000>;
    };
};

/* M5.2 NVS storage partition for the profile librarian.
 *
 * The marisko board dts (boards/arm/sp1/sp1.dts) declares only
 * bootloader_partition @0 (0x20000) + app_partition @0x20000 (0xBF000).
 * The app *partition* (the linker cap on the app image) ends at 0xDF000, but
 * the SP-1 bootloader's actual writable app slot runs to 0xFEFFF — only the
 * last page 0xFF000..0xFFFFF is reserved. The nRF52840 flash is 1 MB
 * (0x100000). We place NVS at the TOP of usable flash (conventional NVS
 * placement: maximally far from a growing app image, just under the reserved
 * page) — a 32 KB (0x8000) region spanning 0xF7000..0xFF000, ending exactly
 * at the reserved page. It is safe because it sits above the linker-capped app
 * region (ends 0xDF000) and just below the only reserved page (0xFF000).
 *
 * Referencing the &flash0 { partitions { ... }; } path MERGES this child into
 * the marisko-declared `partitions` node (which has no label, so it is reached
 * by node path); the bootloader + app partitions survive and all three appear
 * in the merged zephyr.dts. The node is named partition@f7000 so its
 * unit-address matches its reg offset, and labelled storage_partition so
 * FIXED_PARTITION_*(storage_partition) resolves in librarian.c. */
&flash0 {
    partitions {
        storage_partition: partition@f7000 {
            label = "storage";
            reg = <0x000F7000 0x00008000>;
        };
    };
};
